<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Native Ably .NET SDK smoke test. Uses the UNMODIFIED official SDK
    (NuGet package id 'ably.io', namespace IO.Ably) pointed at the host's
    public port over plain HTTP/WS, proving the embedded server is reachable
    through YARP by a stock SDK.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ably.io" Version="1.2.18" />
  </ItemGroup>

</Project>
